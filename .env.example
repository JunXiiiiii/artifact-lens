# Copy to .env and fill in real values. NEVER commit .env.
PORT=3000
VIEWER_PORT=8181

DATABASE_URL=postgresql://username:password@localhost:5432/artifactlens

JWT_SECRET=your_long_random_secret_here
JWT_EXPIRY=7d

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

OWNER_EMAIL=your@email.com

# Optional: SerpAPI key for online museum-match lookup.
# If unset, the app falls back to a best-effort DuckDuckGo lookup.
SERPAPI_KEY=

# Hunyuan3D 3D-generation engine. Local/Colab: reachable URL (tunnel URLs
# change on restart unless reserved). Compose stack: http://hunyuan:8080.
HUNYUAN_BASE_URL=http://localhost:8080
# Optional explicit launch command used by POST /api/3d/start, e.g.
# HUNYUAN_CMD=python /opt/Hunyuan3D-2/hy3dgen_api.py --port 8080
HUNYUAN_CMD=

# ---- docker-compose autonomous stack only ----
DB_PASSWORD=change_me_in_env
HUNYUAN_MODEL_ID=tencent/Hunyuan3D-2mini

NODE_ENV=development
