{
  "name": "artifact-lens",
  "version": "1.0.0",
  "description": "Artifact Lens — FLL UNEARTHED Season. Identify physical artifacts with a laptop camera.",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite client/ --port 5173",
    "build": "vite build client/",
    "serve": "npm run build && vite preview client/ --port 5173",
    "preview": "vite preview",
    "db:init": "node server/scripts/initDb.js",
    "demo:prepare": "node server/scripts/demo-prepare.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.3.26",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
